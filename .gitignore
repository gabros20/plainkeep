# Reference clone of garrytan/gbrain — re-clonable, analyzed for design ideas, not part of this project
ref/

# Harness run artifacts — regenerable, not source
__pycache__/
*.pyc
test/last-run-*.json

# Search index — disposable, rebuilt from content (rm -rf .index && plainkeep index)
.index/

# Optional search venv — the isolated interpreter `plainkeep setup search` provisions (lancedb/fastembed).
# Lives inside PLAINKEEP_HOME (allowed by the path-wall) but is a machine-local, rebuildable cache, never
# source of truth: `rm -rf .venv && plainkeep setup search --yes` recreates it. The dispatcher prefers its
# python3 when present (see the `plainkeep` script + docs/agent-terminal-search.md).
/.venv/

# Run logs — append-only, regenerable
.logs/

# Ephemeral caches — regenerable (e.g. `plainkeep orient --line` prompt cache, short TTL)
.cache/

# Rendered launchd plists — machine-specific (absolute PLAINKEEP_HOME paths), regenerated by `plainkeep job apply`
jobs/launchd/

# macOS noise
.DS_Store

# Obsidian (Frontend Zero, Part 3.1) — .obsidian/ config is user-owned and version-controlled, but its
# machine/cache state is not; the local trash and Smart Connections cache are never source of truth.
.obsidian/workspace*.json
.obsidian/cache
.trash/
.smart-env/

# Claude Code writes internal files into skills dirs + its own runtime dirs — keep the adapter, ignore the rest
skills/**/.system/
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/history.jsonl

# Per-vault Cloudflare Worker deploy config (KV namespace id). Synced template ships wrangler.toml.example only.
bin/share/worker/wrangler.toml

# plainkeep-cli (cli/): TS source for the core binary + absorbed TUI is template-only (NOT in
# engine.txt — vaults get compiled binaries via `plainkeep setup`/`init` instead). Deps are
# regenerable; the installed binaries under .local/bin are caches.
cli/node_modules/
/.local/

# The vault marker (ADR-014 / Task 1a). A plain clone of the template must NOT be adoptable as a
# vault — no marker means walk-up can never select an arbitrary checkout.
.plainkeep/
