#!/usr/bin/env bash
# script/setup — turn a fresh clone of the template into YOUR living ~/plainkeep vault on this machine.
# Idempotent and non-destructive by default. It does NOT push anything (that step stays yours, §3).
#
#   ~/plainkeep/script/setup [--lean|--full] [--yes] [--dry-run] [--no-commit] [--upstream URL]
#
# What it does: puts `plainkeep` on PATH, creates the sibling roots (~/work, ~/files), adds the
# template as `upstream` (so `script/update` can pull engine fixes), optionally strips dev-only
# test/+ref/ for a lean vault, runs `plainkeep doctor --init`, and makes the first commit. Then it
# tells you how to point the vault at your own GitHub and push.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UPSTREAM_URL="https://github.com/gabros20/plainkeep.git"
ROOTS_HOME="${PLAINKEEP_ROOTS_HOME:-$HOME}"          # where ~/work, ~/files are created (override for tests)
BIN_DIR="${PLAINKEEP_BIN_DIR:-$HOME/.local/bin}"      # where the `plainkeep` symlink goes
COMP_DIR="${PLAINKEEP_COMP_DIR:-$HOME/.zsh/completions}"  # where the zsh completion symlink goes
LEAN="ask"; YES=0; DRY=0; COMMIT=1; ENGINE_REF=""

while [ $# -gt 0 ]; do
  case "$1" in
    --lean) LEAN=1 ;;
    --full) LEAN=0 ;;
    --yes|-y) YES=1 ;;
    --dry-run) DRY=1 ;;
    --no-commit) COMMIT=0 ;;
    --upstream) shift; UPSTREAM_URL="$1" ;;
    --engine-ref) shift; ENGINE_REF="$1" ;;   # cloned template SHA (from script/get) → .plainkeep-engine-ref
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac; shift
done

say() { printf '\033[1m%s\033[0m\n' "$*"; }
# run() executes an argv array directly (no eval) so --dir/--repo/--upstream values can never inject
# shell. Each call site passes the command as separate words, not one quoted string.
run() { printf '  +'; printf ' %s' "$@"; printf '\n'; [ "$DRY" = 1 ] || "$@"; }
ask() { [ "$YES" = 1 ] && return 0; read -r -p "  $1 [Y/n] " a; [ -z "$a" ] || [ "$a" = y ] || [ "$a" = Y ]; }

# Clean-tree gate for the auto first-commit (step 6): only auto-commit when the working tree was
# clean at START, so setup never sweeps a user's unrelated uncommitted changes into its own commit.
TREE_WAS_CLEAN=0
[ -z "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ] && TREE_WAS_CLEAN=1

say "plainkeep setup — making this clone your ~/plainkeep vault"
echo "  repo:  $ROOT"
[ "$ROOT" = "$ROOTS_HOME/plainkeep" ] || echo "  note:  for the path-wall, the vault should live at ~/plainkeep (you're at $ROOT)"
echo

say "1. put 'plainkeep' on PATH"
run mkdir -p "$BIN_DIR"
run ln -sf "$ROOT/plainkeep" "$BIN_DIR/plainkeep"
case ":$PATH:" in *":$BIN_DIR:"*) : ;; *) echo "  note:  $BIN_DIR is not on PATH — add it to your shell rc" ;; esac

say "1b. shell completion (zsh — tab-complete verbs, note slugs, task ids)"
run mkdir -p "$COMP_DIR"
run ln -sf "$ROOT/script/completions/_plainkeep" "$COMP_DIR/_plainkeep"
echo "  note:  add to ~/.zshrc (before 'compinit'):  fpath=($COMP_DIR \$fpath)"

say "2. create the sibling roots (never inside this repo)"
for r in work files; do
  if [ -e "$ROOTS_HOME/$r" ]; then echo "  ok:    ~/$r exists"; else run mkdir -p "$ROOTS_HOME/$r"; fi
done
[ -e "$ROOTS_HOME/dotfiles" ] && echo "  ok:    ~/dotfiles detected" || echo "  note:  ~/dotfiles absent — the machine root is optional"

say "3. track the template as 'upstream' (fetch-only, for script/update)"
if git -C "$ROOT" remote | grep -qx upstream; then
  echo "  ok:    upstream already set"
else
  run git -C "$ROOT" remote add upstream "$UPSTREAM_URL"
fi
# fetch-only: disable pushing to upstream so your private vault can never leak to the template.
# `git push` (no remote) goes to origin = your repo; only `script/update` reads from upstream.
run git -C "$ROOT" remote set-url --push upstream DISABLED_no_push_to_template
if git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
  if [ "$(git -C "$ROOT" remote get-url origin)" = "$UPSTREAM_URL" ]; then
    echo "  note:  origin still points at the template — set your own before pushing (step below)"
  else
    echo "  ok:    origin is your own remote"
  fi
else
  echo "  note:  no origin yet — you'll add yours below"
fi

say "3b. record the engine sync ref (.plainkeep-engine-ref) for script/update's 3-way merge"
existing_ref=""
[ -f "$ROOT/.plainkeep-engine-ref" ] && existing_ref="$(tr -d '[:space:]' < "$ROOT/.plainkeep-engine-ref")"
if [ -n "$existing_ref" ] && printf '%s' "$existing_ref" | grep -qiE '^[0-9a-f]{40}$' \
   && git -C "$ROOT" ls-files --error-unmatch .plainkeep-engine-ref >/dev/null 2>&1; then
  echo "  ok:    .plainkeep-engine-ref already present and valid — keeping it"
elif [ -z "$ENGINE_REF" ]; then
  echo "  note:  no --engine-ref given; script/update treats the first sync as a fresh checkout"
elif printf '%s' "$ENGINE_REF" | grep -qiE '^[0-9a-f]{40}$'; then
  if [ "$DRY" = 1 ]; then
    echo "  + write .plainkeep-engine-ref $ENGINE_REF"
  else
    printf '%s\n' "$ENGINE_REF" > "$ROOT/.plainkeep-engine-ref"   # single clean write: one 40-hex SHA + newline
    echo "  ok:    recorded engine ref $ENGINE_REF"
  fi
else
  echo "  note:  ignoring malformed --engine-ref '$ENGINE_REF' (need one 40-hex SHA)"
fi

say "4. lean vault (drop dev-only test/ + ref/)"
if [ "$LEAN" = "ask" ]; then
  if [ "$YES" = 1 ]; then LEAN=0; else ask "Make this a lean vault? (test/+ref/ stay in upstream, restorable)" && LEAN=1 || LEAN=0; fi
fi
if [ "$LEAN" = 1 ]; then
  for p in test ref .github; do
    if git -C "$ROOT" ls-files --error-unmatch "$p" >/dev/null 2>&1; then run git -C "$ROOT" rm -r -q "$p"; fi
  done
  echo "  ok:    lean (engine + content + design docs)"
else
  echo "  ok:    full vault (test harness kept)"
fi

# ADR-014 / Phase 2 Task 1b. A clone of the template is NOT a vault: `.plainkeep/` is gitignored
# precisely so an arbitrary checkout can never present itself as one, and since Task 1b the
# dispatcher refuses a root with no marker. So this is where a clone BECOMES a vault — before step 5,
# because `plainkeep doctor` goes through the dispatcher and would otherwise refuse.
#
# `bin/vault/run.py` is invoked DIRECTLY rather than as `plainkeep vault register`, and that is the
# bootstrap, not a shortcut: `plainkeep <anything>` validates a root first, and the root being
# created here does not exist yet by that definition. It is the same line the refusal message hands
# an operator with an older vault (lib/vaultroot.py, bootstrap_hint).
#
# It is NOT best-effort. If registration fails, nothing after this point works — `doctor --init` and
# every later verb go through the dispatcher, which refuses an unregistered root — so swallowing the
# error would turn a one-line problem into a confusing refusal three steps later. The two realistic
# failures both name their own fix: the path is already registered (which re-running setup hits, and
# which is fine), or the NAME is taken by another vault, which `register` says out loud along with
# the --name flag that resolves it.
say "4b. mark + register this vault (the dispatcher will not act on an unregistered root)"
REG_LOG="$(mktemp "${TMPDIR:-/tmp}/pk-setup-register.XXXXXX")"
if [ "$DRY" = 1 ]; then
  echo "  + env PLAINKEEP_HOME=$ROOT python3 $ROOT/bin/vault/run.py register $ROOT --yes"
elif env PLAINKEEP_HOME="$ROOT" python3 "$ROOT/bin/vault/run.py" register "$ROOT" --yes >"$REG_LOG" 2>&1; then
  sed 's/^/  /' "$REG_LOG"
elif grep -q "already registered" "$REG_LOG"; then
  echo "  ok:    already registered"
else
  sed 's/^/  /' "$REG_LOG" >&2
  rm -f "$REG_LOG"
  echo "setup cannot continue: every verb below needs a registered root." >&2
  exit 2
fi
rm -f "$REG_LOG"

say "5. validate the skeleton"
run env PLAINKEEP_HOME="$ROOT" "$ROOT/plainkeep" doctor --init

say "6. first commit"
if [ "$COMMIT" = 1 ]; then
  if [ "$DRY" != 1 ] && [ "$TREE_WAS_CLEAN" != 1 ]; then
    echo "  note:  the working tree had uncommitted changes before setup — skipping the auto first-commit"
    echo "         (setup never stages unrelated changes). Review and commit yourself:"
    echo "           git -C '$ROOT' status"
    echo "           git -C '$ROOT' commit -am 'plainkeep: machine setup'"
  else
    run git -C "$ROOT" add -A
    if [ "$DRY" = 1 ] || ! git -C "$ROOT" diff --cached --quiet; then
      run git -C "$ROOT" -c commit.gpgsign=false commit -q -m 'plainkeep: machine setup (vault initialized)'
    else
      echo "  ok:    nothing to commit"
    fi
  fi
fi

echo
say "done. next (these are yours to run — setup never pushes):"
cat <<EOF
  • finish setup (guided):     plainkeep setup --wizard      (interactive first-run, safe defaults)
                    or all-in:  plainkeep setup --all --yes   (non-interactive; 'plainkeep setup' = dashboard)
  • point at your GitHub:      git -C "$ROOT" remote set-url origin git@github.com:<you>/plainkeep.git
                               git -C "$ROOT" push -u origin main
  • daily:                     plainkeep start  ·  plainkeep capture "…"  ·  plainkeep triage  ·  plainkeep close
EOF
