#!/usr/bin/env bash
# script/update — pull engine improvements from the template without touching your content.
#
#   ~/plainkeep/script/update [--remote upstream] [--branch main]
#
# It fetches the template and checks out ONLY the engine paths listed in script/engine.txt — so
# bin/, skills/, the dispatcher, the contract files, and the design docs are refreshed, while your
# wiki/ tasks/ journal/ jobs/registry.json and a lean vault's dropped test/ are left exactly as they
# are. Changes are STAGED, not committed: review `git diff --staged`, then commit when you're happy.
#
# SINCE PHASE 2 TASK 2 THIS UPDATES THE SOURCE, NOT THE RUNNING ENGINE. The engine is installed as
# its own versioned, read-only tree outside every vault, and what this script refreshes is the
# CHECKOUT those files are installed from. Pulling a fix and running it are now two steps:
#   script/update      # pull engine files into this checkout (staged, reviewable)
#   script/setup --yes # install them as a version and re-point `current`
# That is the trade the split buys — an update you have not installed cannot break a running vault,
# and a rollback is re-activating the previous version.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REMOTE="upstream"; BRANCH="main"
while [ $# -gt 0 ]; do
  case "$1" in
    --remote) shift; REMOTE="$1" ;;
    --branch) shift; BRANCH="$1" ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac; shift
done

git -C "$ROOT" remote | grep -qx "$REMOTE" || { echo "no '$REMOTE' remote — run script/setup first" >&2; exit 1; }

# THE MANIFEST IS ITSELF AN ENGINE PATH, so a single pass can never deliver a path the update ADDS
# to it: the walk below reads script/engine.txt as it was when the run started, while refreshing that
# same file for next time. When upstream added `pyproject.toml`/`uv.lock`, every existing vault
# pulled the new manifest but not the files it named, and `script/setup` then refused with
# "source tree is missing pyproject.toml" — a message about a missing file, for what is actually a
# stale manifest. Same trap for `templates/verb`: unsynced in pass 1, and since the recorded ref
# predates the path there is no merge base, so the vault's stale copy survives and later trips the
# migration's DIVERGED preflight on a file the user never edited.
#
# So: note the manifest now, and if the walk changes it, re-exec ONCE against the new one. A stable
# manifest makes the second pass a no-op, so this converges; PLAINKEEP_UPDATE_PASS caps it at two
# regardless, because a manifest that never stabilises must not loop forever.
MANIFEST_BEFORE="$(git -C "$ROOT" hash-object "$ROOT/script/engine.txt" 2>/dev/null || echo absent)"
UPDATE_PASS="${PLAINKEEP_UPDATE_PASS:-1}"

printf '\033[1mfetching %s\033[0m\n' "$REMOTE"
git -C "$ROOT" fetch -q "$REMOTE"

# 3-way merge (Part 0.1): plain `git checkout upstream -- path` silently DISCARDS local engine edits.
# .plainkeep-engine-ref records the last-synced upstream commit; per engine FILE: unmodified since that ref
# → fast-path checkout; locally modified → `git merge-file` (base=ref, theirs=upstream, ours=working
# tree), staged, with conflict markers surfaced. First run (no ref) falls back + warns loudly.
UPSTREAM_SHA="$(git -C "$ROOT" rev-parse "$REMOTE/$BRANCH")"
REFFILE="$ROOT/.plainkeep-engine-ref"
REF=""
if [ -f "$REFFILE" ]; then
  REF="$(tr -d '[:space:]' < "$REFFILE")"
  # The ref MUST be exactly one 40-hex commit SHA. A corrupted ref (e.g. two SHAs concatenated by an
  # interrupted/duplicated write) makes `git rev-parse "$REF:path"` fail, so every engine file then
  # 3-way-merges against an EMPTY base → spurious conflict markers everywhere. Reject a malformed or
  # unknown ref loudly and fall back to the no-ref path (fast checkout) — never merge against garbage.
  if ! printf '%s' "$REF" | grep -qiE '^[0-9a-f]{40}$'; then
    printf '\033[33mwarning: .plainkeep-engine-ref is not a single 40-char SHA (%d chars) — ignoring it; treating as a first sync (it is rewritten cleanly below).\033[0m\n' "${#REF}" >&2
    REF=""
  elif ! git -C "$ROOT" rev-parse --verify --quiet "${REF}^{commit}" >/dev/null 2>&1; then
    printf '\033[33mwarning: .plainkeep-engine-ref %s is not a fetched commit — treating as a first sync; run `git fetch %s` for a real 3-way merge.\033[0m\n' "${REF:0:8}" "$REMOTE" >&2
    REF=""
  fi
fi
CONFLICTS=()

g() { git -C "$ROOT" "$@"; }

fast_path() {  # checkout upstream over a locally-unmodified (or absent) file — stages it
  g checkout -q "$REMOTE/$BRANCH" -- "$1" && echo "  ~ $1"
}

merge_file() {  # 3-way merge upstream changes into our working file; base = ref version (may be empty)
  local f="$1" ref_hash="$2" theirs_hash="$3" base theirs
  base="$(mktemp)"; theirs="$(mktemp)"
  [ -n "$ref_hash" ] && g cat-file blob "$ref_hash" > "$base" || : > "$base"
  g cat-file blob "$theirs_hash" > "$theirs"
  if git merge-file -q -L "ours (local)" -L "base (last sync)" -L "upstream" "$ROOT/$f" "$base" "$theirs"; then
    g add -- "$f"; echo "  merged $f"
  else
    g add -- "$f"; echo "  CONFLICT $f — resolve the <<<<<<< markers"; CONFLICTS+=("$f")
  fi
  rm -f "$base" "$theirs"
}

if [ -z "$REF" ]; then
  printf '\033[33mwarning: no .plainkeep-engine-ref — first sync cannot 3-way merge; local engine edits may be overwritten. Recording the ref for next time.\033[0m\n' >&2
  printf '\033[1mrefreshing engine paths from %s/%s\033[0m\n' "$REMOTE" "$BRANCH"
  while IFS= read -r path; do
    case "$path" in ''|\#*) continue ;; esac
    g cat-file -e "$REMOTE/$BRANCH:$path" 2>/dev/null && fast_path "$path"
  done < "$ROOT/script/engine.txt"
else
  printf '\033[1mmerging engine paths from %s/%s (base %s)\033[0m\n' "$REMOTE" "$BRANCH" "${REF:0:8}"
  while IFS= read -r path; do
    case "$path" in ''|\#*) continue ;; esac
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      theirs_hash="$(g rev-parse "$REMOTE/$BRANCH:$f" 2>/dev/null)" || continue
      if [ ! -e "$ROOT/$f" ]; then fast_path "$f"; continue; fi          # absent locally → take upstream
      ours_hash="$(g hash-object "$ROOT/$f" 2>/dev/null || true)"
      # A working-tree path git can't hash (e.g. `.codex/skills`, a tracked symlink to a directory)
      # must NOT abort the whole update under `set -e` — take upstream's version and move on.
      [ -n "$ours_hash" ] || { fast_path "$f"; continue; }
      [ "$ours_hash" = "$theirs_hash" ] && continue                       # already identical → skip
      ref_hash="$(g rev-parse "$REF:$f" 2>/dev/null || true)"
      if [ -n "$ref_hash" ] && [ "$ours_hash" = "$ref_hash" ]; then
        fast_path "$f"                                                    # unmodified since ref → fast
      else
        merge_file "$f" "$ref_hash" "$theirs_hash"                        # diverged → 3-way merge
      fi
    done < <(g ls-tree -r --name-only "$REMOTE/$BRANCH" -- "$path")
  done < "$ROOT/script/engine.txt"
fi

MANIFEST_AFTER="$(git -C "$ROOT" hash-object "$ROOT/script/engine.txt" 2>/dev/null || echo absent)"
if [ "$MANIFEST_AFTER" != "$MANIFEST_BEFORE" ] && [ "$UPDATE_PASS" -lt 2 ]; then
  printf '\033[1mscript/engine.txt changed — re-running against the new manifest\033[0m\n'
  # Before the ref is written, so the second pass still 3-way merges against the ref it started
  # with rather than against the commit it is currently syncing to.
  PLAINKEEP_UPDATE_PASS=2 exec "$ROOT/script/update" --remote "$REMOTE" --branch "$BRANCH"
fi

printf '%s\n' "$UPSTREAM_SHA" > "$REFFILE"; g add -- .plainkeep-engine-ref   # single clean write: one SHA + newline, never appended

# `plainkeep.json` is regenerated from any new cmd.json — through the INSTALLED launcher, and only
# if there IS one. Running `$ROOT/plainkeep` here would be the engine acting on itself (engine root
# == data root), which discovery refuses with exit 5 since Phase 2 Task 2; and the freshly PULLED
# engine files are source, not an installed version, so they are not what should regenerate anything
# until `script/setup` installs them. Best-effort, exactly as it was: a vault with no engine on PATH
# yet gets its manifest on the first real invocation.
command -v plainkeep >/dev/null 2>&1 \
  && env PLAINKEEP_HOME="$ROOT" plainkeep help >/dev/null 2>&1 || true
echo
if [ "${#CONFLICTS[@]}" -gt 0 ]; then
  printf '\033[1m\033[33m%d file(s) have merge conflicts — resolve before committing:\033[0m\n' "${#CONFLICTS[@]}"
  for c in "${CONFLICTS[@]}"; do echo "  ! $c"; done
  echo
fi
if git -C "$ROOT" diff --cached --quiet; then
  printf '\033[1malready up to date.\033[0m\n'
else
  printf '\033[1mengine updated (staged).\033[0m review, INSTALL, then commit:\n'
  echo "  git -C '$ROOT' diff --staged       # what changed"
  echo "  '$ROOT/script/setup' --yes                # install the pulled engine + re-point PATH"
  echo "  plainkeep doctor                          # confirm healthy"
  echo "  git -C '$ROOT' commit -m 'plainkeep: update engine from upstream'"
fi
