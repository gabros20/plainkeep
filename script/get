#!/usr/bin/env bash
# script/get — the install funnel (proposal Part 5.4). A hardened, INSPECTABLE curl|sh bootstrap
# (the rustup pattern). It does the least possible: check prereqs, clone the vault, then hand off to
# the ONE idempotent setup path (script/setup). No sudo, ever; refuses to overwrite an install.
#
# Inspect before you run (never pipe a script you haven't read):
#
#   curl --proto '=https' --tlsv1.2 -fsSL \
#     https://raw.githubusercontent.com/gabros20/plainkeep/main/script/get -o get.sh
#   shasum -a 256 get.sh          # compare against the published get.sh.sha256 for the same ref
#   less get.sh                    # read it
#   sh get.sh                      # then, and only then, run it
#
# (`--proto '=https' --tlsv1.2` pins TLS ≥1.2 over HTTPS-only, so a downgrade/redirect can't feed you
# a different transport; publishing get.sh.sha256 next to the raw file lets you verify byte integrity.
# We never auto-verify our own hash — that would be theatre; verification is the reader's, pre-run.)
#
# Usage:
#   script/get [--demo] [--full] [--dry-run] [--dir PATH] [--repo URL] [--yes]
#     --demo      clone into a THROWAWAY tmp dir seeded with example notes; capture/search/week work
#                 immediately. Prints the one directory to delete to walk away. Touches nothing else.
#     --full      keep the dev-only test/ + ref/ tree (for contributors). Default is a LEAN vault
#                 (engine + content; test/+ref/ dropped, restorable from upstream).
#     --dry-run   print every step, change nothing (no clone, no setup).
#     --dir PATH  install location (default: $HOME/plainkeep; env PLAINKEEP_GET_DIR).
#     --repo URL  clone source        (default: the upstream template; env PLAINKEEP_GET_REPO).
#     --yes       accepted for compatibility; the real install is ALWAYS non-interactive now
#                 (so a piped `curl … | sh` never blocks), so this flag is a no-op.
#
# Homebrew stance: a formula would clone vault CONTENT into a brew-owned prefix — the exact opposite
# of a user-owned repo. If we ever ship a tap it is ONLY a tiny bootstrapper that runs THIS script
# (the chezmoi model), never a formula that owns your notes. Windows: use WSL2 (documented; no native
# PowerShell path).
set -euo pipefail

REPO_URL="${PLAINKEEP_GET_REPO:-https://github.com/gabros20/plainkeep.git}"
TARGET="${PLAINKEEP_GET_DIR:-$HOME/plainkeep}"
DEMO=0; DRY=0; YES=0; FULL=0

while [ $# -gt 0 ]; do
  case "$1" in
    --demo) DEMO=1 ;;
    --full) FULL=1 ;;
    --dry-run) DRY=1 ;;
    --dir) shift; TARGET="$1" ;;
    --repo) shift; REPO_URL="$1" ;;
    --yes|-y) YES=1 ;;
    -h|--help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac; shift
done

say() { printf '\033[1m%s\033[0m\n' "$*"; }
run() { printf '  + %s\n' "$*"; [ "$DRY" = 1 ] || eval "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "get: missing prerequisite '$1' — install it and re-run" >&2; exit 1; }; }

say "plainkeep get — bootstrap a vault (clone + hand off to script/setup)"
need git
need python3
# Python floor: the verbs use PEP 604 `str | None` syntax, so 3.10 is the true minimum. Fail early
# with a clear message rather than letting a verb crash later on an old interpreter.
PYVER="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo '?')"
python3 -c 'import sys; sys.exit(0 if sys.version_info[:2] >= (3, 10) else 1)' 2>/dev/null \
  || { echo "get: python3 is $PYVER — plainkeep needs Python 3.10+ (uses \`str | None\` syntax). Install a newer python3 and re-run." >&2; exit 1; }
echo "  git:     $(command -v git)"
echo "  python3: $(command -v python3) ($PYVER)"
echo

# --demo: everything lands under one throwaway dir (the roots too, via PLAINKEEP_ROOTS_HOME), so a
# single `rm -rf` walks away. No PATH symlink, no completion install, no commit — pure sandbox.
if [ "$DEMO" = 1 ]; then
  if [ -n "${PLAINKEEP_GET_DIR:-}" ]; then
    DEMO_DIR="$TARGET"
    [ -e "$DEMO_DIR" ] && [ -n "$(ls -A "$DEMO_DIR" 2>/dev/null)" ] && { echo "get: --demo dir '$DEMO_DIR' is not empty" >&2; exit 1; }
  else
    DEMO_DIR="$(mktemp -d "${TMPDIR:-/tmp}/plainkeep-demo.XXXXXX")"
  fi
  VAULT="$DEMO_DIR/plainkeep"
  say "1. clone into a throwaway demo vault"
  run "git clone --depth 1 -q '$REPO_URL' '$VAULT'"
  # Capture the cloned template SHA BEFORE setup does any lean-strip/first-commit, so setup can seed
  # .plainkeep-engine-ref with the exact upstream base for script/update's 3-way merge.
  ENGINE_REF=""
  [ "$DRY" = 1 ] || ENGINE_REF="$(git -C "$VAULT" rev-parse HEAD 2>/dev/null || true)"
  REF_ARG=""; [ -n "$ENGINE_REF" ] && REF_ARG="--engine-ref $ENGINE_REF"
  say "2. setup (sandboxed: roots, PATH, completion all inside the demo dir)"
  # PLAINKEEP_CONFIG_HOME is inside the demo dir too (Task 1b): setup now registers the vault, and
  # the registry lives OUTSIDE every vault — in the real ~/.config unless it is redirected. `rm -rf`
  # on one directory is this mode's whole promise, so the registry entry has to be in there with
  # everything else.
  # PLAINKEEP_ENGINE_HOME goes in the demo dir for the same reason (Phase 2 Task 2): setup now
  # INSTALLS the engine, and its default install root is `~/.local/share/plainkeep`, i.e. outside the
  # one directory this mode promises you can delete. Everything the demo creates has to be under
  # `$DEMO_DIR` or the promise is false.
  SETUP_ENV="PLAINKEEP_ROOTS_HOME='$DEMO_DIR' PLAINKEEP_BIN_DIR='$DEMO_DIR/.bin' PLAINKEEP_COMP_DIR='$DEMO_DIR/.comp' PLAINKEEP_CONFIG_HOME='$DEMO_DIR/.config' PLAINKEEP_ENGINE_HOME='$DEMO_DIR/.engine' PLAINKEEP_HOME='$VAULT'"
  # The launcher the demo invokes is the INSTALLED one, not `$VAULT/plainkeep`: the vault and the
  # engine may not be the same tree, and `$VAULT/plainkeep` against `$VAULT` is refused with exit 5.
  DEMO_PK="$DEMO_DIR/.engine/engine/current/plainkeep"
  run "env $SETUP_ENV '$VAULT/script/setup' --full --yes --no-commit $REF_ARG --upstream '$REPO_URL'"
  say "3. seed example notes so search/week have something to show"
  run "env $SETUP_ENV '$DEMO_PK' capture 'demo: try plainkeep search, plainkeep week, plainkeep task add'"
  if [ "$DRY" != 1 ]; then
    mkdir -p "$VAULT/wiki/notes"
    cat > "$VAULT/wiki/notes/demo-welcome.md" <<'NOTE'
---
type: note
title: Demo welcome
status: active
tags: [demo, starter]
aliases: [demo]
---
# Demo welcome

This is a throwaway demo vault. Try:

- `plainkeep search demo` — ranked hits across your notes
- `plainkeep week` — the weekly review
- `plainkeep task add "kick the tyres"` — add a task

Delete the one directory printed below to walk away — nothing else on your machine was touched.
NOTE
  fi
  run "env $SETUP_ENV '$DEMO_PK' index"
  echo
  say "demo ready. everything is under ONE directory:"
  echo "  vault:  $VAULT   (your notes)"
  echo "  engine: $DEMO_DIR/.engine/engine/current   (the code, installed separately)"
  echo "  try:    PLAINKEEP_HOME='$VAULT' '$DEMO_PK' search demo"
  echo "          PLAINKEEP_HOME='$VAULT' '$DEMO_PK' week"
  say "walk away (deletes the whole demo, touches nothing else):"
  echo "  rm -rf '$DEMO_DIR'"
  exit 0
fi

# Real install: refuse to overwrite an existing vault (never clobber the user's content).
if [ -e "$TARGET" ] && [ -n "$(ls -A "$TARGET" 2>/dev/null)" ]; then
  echo "get: '$TARGET' already exists and is not empty — refusing to overwrite." >&2
  echo "     to update an existing vault use: '$TARGET/script/update'" >&2
  echo "     or install elsewhere with:       script/get --dir /path/to/vault" >&2
  exit 1
fi

say "1. clone the vault"
echo "  from:  $REPO_URL"
echo "  into:  $TARGET"
run "git clone -q '$REPO_URL' '$TARGET'"

# Capture the cloned template SHA BEFORE setup's lean-strip/first-commit, so setup can seed
# .plainkeep-engine-ref with the exact upstream base for script/update's 3-way merge.
ENGINE_REF=""
[ "$DRY" = 1 ] || ENGINE_REF="$(git -C "$TARGET" rev-parse HEAD 2>/dev/null || true)"

say "2. hand off to the one setup path (script/setup)"
# The funnel install is ALWAYS non-interactive (`--yes`) so a piped `curl … | sh` never blocks on
# setup's lean/full prompt, and defaults to a LEAN vault — passing `--lean` explicitly so `--yes`
# never silently falls through to FULL (setup's `--yes`-without-a-lean-choice default). `--full`
# keeps the dev-only test/+ref/ tree for contributors.
SETUP_ARGS="--yes"
if [ "$FULL" = 1 ]; then SETUP_ARGS="$SETUP_ARGS --full"; else SETUP_ARGS="$SETUP_ARGS --lean"; fi
[ "$DRY" = 1 ] && SETUP_ARGS="$SETUP_ARGS --dry-run"
[ -n "$ENGINE_REF" ] && SETUP_ARGS="$SETUP_ARGS --engine-ref $ENGINE_REF"
if [ "$DRY" = 1 ] && [ ! -x "$TARGET/script/setup" ]; then
  echo "  + $TARGET/script/setup $SETUP_ARGS   (skipped: nothing cloned in --dry-run)"
else
  run "'$TARGET/script/setup' $SETUP_ARGS"
fi

echo
say "done. setup printed your next steps (point origin at your GitHub, then push — get never transmits)."
